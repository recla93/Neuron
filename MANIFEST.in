recursive-include src/neuron/data *.png
include assets/neuron-logo.png

# Useful top-level docs/config for the sdist.
# NOT CLAUDE.md — that's internal project/AI instructions, not a shipped doc.
include README.md
include CHANGELOG.md
include docs/DEVELOPER.md
include INSTALL.md
include LICENSE

# Keep junk out of the sdist.
global-exclude *.py[cod]
global-exclude __pycache__/*
prune tests
